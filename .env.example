# App
APP_URL="http://localhost:3000"
# Optional commerce pilot. Apply migration 0062 before enabling.
# Buyer login requires SMTP; artwork upload requires private Supabase Storage.
COMMERCE_ENABLED="false"
# Autorize somente dominios ja adicionados/verificados no projeto Vercel.
# A primeira entrada de cada tenant define a URL principal. APP_URL continua sendo o painel.
# Exemplo: {"groundshop.com.br":"ground-shop","www.groundshop.com.br":"ground-shop"}
COMMERCE_CUSTOM_DOMAINS='{}'
COOKIE_NAME="pricing_session"
# Alternativa manual/externa da fila Olist: GET /api/cron/commerce-olist.
# O Vercel Schedule privado em vercel.json NAO utiliza este segredo.
# Authorization: Bearer <CRON_SECRET>. Gere um segredo aleatorio com 32+ caracteres.
CRON_SECRET=""
AUTH_SECRET="change-me-to-a-random-secret-with-at-least-32-characters"
APP_ENCRYPTION_KEY="change-me-to-a-random-encryption-key-with-32-plus-chars"

# Supabase Postgres
# Use a connection string Postgres. Para Supabase, prefira a string pooled ou direct conforme o ambiente.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pricing_pro"
# auto habilita SSL para hosts Supabase e em producao. Use "true" para forcar ou "false" para Postgres local.
DATABASE_SSL="auto"
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Email de convites via SMTP (opcional; sem isso o sistema gera o link para copiar)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="liaflow.ai@gmail.com"
SMTP_PASS=""

# Mercado Pago - cobranca da plataforma
MERCADO_PAGO_ACCESS_TOKEN=""
MERCADO_PAGO_WEBHOOK_SECRET=""

# OpenRouter - assistente criativo de artes (opcional)
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_TEXT_MODEL="openai/gpt-4.1-mini"
# Store assistant: GPT default, Gemini fallback. Explicit lists also authorize the fallback.
OPENROUTER_ASSISTANT_MODELS="openai/gpt-4.1-mini,google/gemini-3.1-flash-lite"
OPENROUTER_IMAGE_MODEL="openai/gpt-image-1"

# Tenant-specific company data and integration credentials are stored in Postgres.
# See supabase/migrations/0004_tenant_profile_integrations.sql.
