# App
APP_URL="http://localhost:3000"
COOKIE_NAME="pricing_session"
AUTH_SECRET="change-me-to-a-random-secret-with-at-least-32-characters"
APP_ENCRYPTION_KEY="change-me-to-a-random-encryption-key-with-32-plus-chars"

# Supabase Postgres
# Use a connection string Postgres. Para Supabase, prefira a string pooled ou direct conforme o ambiente.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pricing_pro"
# auto habilita SSL para hosts Supabase e em producao. Use "true" para forcar ou "false" para Postgres local.
DATABASE_SSL="auto"
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Email de convites via SMTP (opcional; sem isso o sistema gera o link para copiar)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="liaflow.ai@gmail.com"
SMTP_PASS=""

# Mercado Pago - cobranca da plataforma
MERCADO_PAGO_ACCESS_TOKEN=""
MERCADO_PAGO_WEBHOOK_SECRET=""

# OpenRouter - assistente criativo de artes (opcional)
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_TEXT_MODEL="openai/gpt-4.1-mini"
OPENROUTER_IMAGE_MODEL="openai/gpt-image-1"

# Tenant-specific company data and integration credentials are stored in Postgres.
# See supabase/migrations/0004_tenant_profile_integrations.sql.
